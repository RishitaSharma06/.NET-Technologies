@model SmartCampusPortal.Models.ServiceRequest

@{
    ViewData["Title"] = "Raise Campus Service Request";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">New Campus Service Request</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="StudentName" class="form-label fw-semibold"></label>
                    <input asp-for="StudentName" class="form-control" placeholder="Enter your full name" />
                    <span asp-validation-for="StudentName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EnrollmentNo" class="form-label fw-semibold"></label>
                        <input asp-for="EnrollmentNo" class="form-control" placeholder="e.g., 92400103310" />
                        <span asp-validation-for="EnrollmentNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <select asp-for="Department" class="form-select">
                            <option value="Computer Engineering">Computer Engineering</option>
                            <option value="Information Technology">Information Technology</option>
                            <option value="Mechanical Engineering">Mechanical Engineering</option>
                            <option value="Civil Engineering">Civil Engineering</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <select asp-for="Category" class="form-select">
                            <option value="Wi-Fi / Network">Wi-Fi / Network</option>
                            <option value="Lab Equipment">Lab Equipment</option>
                            <option value="Electrical / Maintenance">Electrical / Maintenance</option>
                            <option value="Hostel & Canteen">Hostel & Canteen</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority" class="form-label fw-semibold"></label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the issue and room/lab location..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to Portal</a>
                    <button type="submit" class="btn btn-success">Submit Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
