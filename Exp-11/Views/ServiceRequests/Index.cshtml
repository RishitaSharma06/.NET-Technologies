@model IEnumerable<SmartCampusPortal.Models.ServiceRequest>

@{
    ViewData["Title"] = "Smart Campus Service Portal";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0">Smart Campus Service Portal</h2>
            <small class="text-muted">Integrated MVC + SQL Server + Live Web API Extension</small>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Raise New Ticket</a>
    </div>

    <!-- Live API Summary Cards -->
    <div class="row g-3 mb-4" id="apiStatsCards">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-muted">Total Requests</h6>
                    <h3 class="fw-bold mb-0" id="statTotal">-</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger-subtle">
                <div class="card-body">
                    <h6 class="text-danger">Open Tickets</h6>
                    <h3 class="fw-bold text-danger mb-0" id="statOpen">-</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning-subtle">
                <div class="card-body">
                    <h6 class="text-warning-emphasis">In Progress</h6>
                    <h3 class="fw-bold text-warning-emphasis mb-0" id="statInProgress">-</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success-subtle">
                <div class="card-body">
                    <h6 class="text-success">Resolved</h6>
                    <h3 class="fw-bold text-success mb-0" id="statResolved">-</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Filter Bar -->
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="categoryFilter" class="form-select" onchange="this.form.submit()">
                <option value="All" selected="@(ViewBag.SelectedCategory == "All")">All Categories</option>
                <option value="Wi-Fi / Network" selected="@(ViewBag.SelectedCategory == "Wi-Fi / Network")">Wi-Fi / Network</option>
                <option value="Lab Equipment" selected="@(ViewBag.SelectedCategory == "Lab Equipment")">Lab Equipment</option>
                <option value="Electrical / Maintenance" selected="@(ViewBag.SelectedCategory == "Electrical / Maintenance")">Electrical / Maintenance</option>
                <option value="Hostel & Canteen" selected="@(ViewBag.SelectedCategory == "Hostel & Canteen")">Hostel & Canteen</option>
            </select>
        </div>
    </form>

    <!-- Service Tickets Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Student</th>
                        <th>Department</th>
                        <th>Category</th>
                        <th>Issue Description</th>
                        <th>Priority</th>
                        <th>Live Status (API)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@item.TicketId</td>
                            <td>
                                <div>@item.StudentName</div>
                                <small class="text-muted">@item.EnrollmentNo</small>
                            </td>
                            <td>@item.Department</td>
                            <td><span class="badge bg-info text-dark">@item.Category</span></td>
                            <td>@item.Description</td>
                            <td>
                                <span class="badge @(item.Priority == "High" ? "bg-danger" : item.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                                    @item.Priority
                                </span>
                            </td>
                            <td>
                                <!-- Updates Database via Web API PATCH call -->
                                <select class="form-select form-select-sm" onchange="updateStatusViaApi(@item.TicketId, this.value)">
                                    <option value="Open" selected="@(item.Status == "Open")">Open</option>
                                    <option value="In Progress" selected="@(item.Status == "In Progress")">In Progress</option>
                                    <option value="Resolved" selected="@(item.Status == "Resolved")">Resolved</option>
                                </select>
                            </td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@item.TicketId" method="post" onsubmit="return confirm('Delete this ticket?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Fetch live stats from /api/CampusApi/stats on page load
        async function loadApiStats() {
            const response = await fetch('/api/CampusApi/stats');
            if (response.ok) {
                const data = await response.json();
                document.getElementById('statTotal').innerText = data.total;
                document.getElementById('statOpen').innerText = data.open;
                document.getElementById('statInProgress').innerText = data.inProgress;
                document.getElementById('statResolved').innerText = data.resolved;
            }
        }

        // 2. Update ticket status via Web API PATCH endpoint without page reload
        async function updateStatusViaApi(ticketId, newStatus) {
            const response = await fetch(`/api/CampusApi/status/${ticketId}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });

            if (response.ok) {
                loadApiStats(); // Refresh top counters immediately
            } else {
                alert('Failed to update status via API.');
            }
        }

        document.addEventListener('DOMContentLoaded', loadApiStats);
    </script>
}
