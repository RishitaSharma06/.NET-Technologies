@model List<ProductCatalog_App.Models.Product>

<div class="catalog-container">

    <div class="catalog-header">

        <div>
            <div class="catalog-title">
                🛍️ Product Catalog
            </div>

            <div class="catalog-subtitle">
                Manage your products easily
            </div>
        </div>

        <a href="/Product/Create" class="add-btn">
            + Add Product
        </a>

    </div>


    <table class="product-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Product</th>
                <th>Price</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>


        <tbody>

            @foreach (var product in Model)
            {
                <tr>

                    <td>
                        #@product.Id
                    </td>

                    <td class="product-name">
                        @product.Name
                    </td>

                    <td class="price">
                        ₹@product.Price
                    </td>

                    <td>
                        <span class="category">
                            @product.Category
                        </span>
                    </td>

                    <td>

                        <a href="/Product/Edit/@product.Id"
                           class="edit-btn">
                            ✏ Edit
                        </a>

                        <a href="/Product/Delete/@product.Id"
                           class="delete-btn"
                           onclick="return confirm('Are you sure you want to delete this product?');">
                            🗑 Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
