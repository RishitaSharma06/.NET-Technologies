@model FeedbackApp.Models.Feedback

@{
    ViewData["Title"] = "Give Feedback";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <h2 class="fw-bold mb-4" style="color: #2b2b2b;">Give Feedback</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold text-secondary small mb-1">Name</label>
                <input asp-for="Name" class="form-control form-control-blue-tint py-2" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold text-secondary small mb-1">Email</label>
                <input asp-for="Email" type="email" class="form-control form-control-blue-tint py-2" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rating" class="form-label fw-semibold text-secondary small mb-1">Rating</label>
                <select asp-for="Rating" class="form-select form-control-cream-tint py-2">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5" selected>5</option>
                </select>
                <span asp-validation-for="Rating" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Comments" class="form-label fw-semibold text-secondary small mb-1">Comments</label>
                <textarea asp-for="Comments" class="form-control form-control-cream-tint" rows="4"></textarea>
                <span asp-validation-for="Comments" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark-green px-4 py-2">Submit Feedback</button>
                <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="background-color: #6c757d; border: none;">View Feedback</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
