@model IEnumerable<FeedbackApp.Models.Feedback>

@{
    ViewData["Title"] = "Feedback List";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <h2 class="fw-bold mb-3" style="color: #2b2b2b;">Feedback List</h2>

        <div class="mb-4">
            <a asp-action="Create" class="btn btn-tan px-3 py-2 fs-6">Add Feedback</a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-custom table-bordered align-middle">
                    <thead>
                        <tr>
                            <th class="py-3 px-3">Name</th>
                            <th class="py-3 px-3">Email</th>
                            <th class="py-3 px-3">Rating</th>
                            <th class="py-3 px-3">Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 px-3">@item.Name</td>
                                <td class="py-3 px-3">@item.Email</td>
                                <td class="py-3 px-3">@item.Rating / 5</td>
                                <td class="py-3 px-3">@item.Comments</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-secondary mt-3">No feedback available.</p>
        }
    </div>
</div>
