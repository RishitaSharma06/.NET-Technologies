<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feedback Hub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f6f3eb;
            color: #222222;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        .navbar-custom {
            background-color: #232f26;
            border-bottom: 2px solid #a38448;
        }

        .navbar-brand-text {
            color: #ffffff;
            font-weight: 800;
            letter-spacing: 1.5px;
            font-size: 1.35rem;
        }

        .btn-nav-outline {
            color: #e5d2a0;
            border: 1px solid #58665b;
            font-size: 0.875rem;
            padding: 0.375rem 0.85rem;
            text-decoration: none;
            border-radius: 4px;
        }

        .btn-nav-outline:hover {
            color: #ffffff;
            background-color: #354439;
            border-color: #a38448;
        }

        .btn-tan {
            background-color: #997843;
            color: #ffffff;
            border: none;
            font-weight: 500;
        }

        .btn-tan:hover {
            background-color: #826435;
            color: #ffffff;
        }

        .btn-dark-green {
            background-color: #2a372e;
            color: #ffffff;
            border: none;
            font-weight: 500;
        }

        .btn-dark-green:hover {
            background-color: #1e2821;
            color: #ffffff;
        }

        .table-custom th {
            background-color: #27352a !important;
            color: #ffffff !important;
            border-color: #39473c;
            font-size: 0.95rem;
        }

        .table-custom td {
            background-color: #ffffff;
            border-color: #e5e0d8;
            font-size: 0.9rem;
        }

        .footer-custom {
            background-color: #232f26;
            color: #c2c7c3;
            border-top: 2px solid #a38448;
        }

        .footer-title {
            color: #d8b368;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .form-control-blue-tint {
            background-color: #edf3fc !important;
            border: 1px solid #d0d7de;
        }

        .form-control-cream-tint {
            background-color: #fbf9f4 !important;
            border: 1px solid #cfc7b9;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-custom py-3">
            <div class="container px-4">
                <a class="navbar-brand navbar-brand-text m-0" asp-controller="Feedback" asp-action="Index">FEEDBACK.</a>
                <div class="d-flex gap-2">
                    <a class="btn-nav-outline" asp-controller="Feedback" asp-action="Index">Home</a>
                    <a class="btn-nav-outline" asp-controller="Feedback" asp-action="Create">+ Give Feedback</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container px-4 py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom py-4 mt-auto text-center fs-7">
        <div class="container">
            <div class="footer-title mb-1">FEEDBACK HUB</div>
            <p class="mb-1 text-light-50" style="font-size: 0.85rem;">Your opinion matters. Thank you for sharing!</p>
            <p class="mb-0 text-secondary" style="font-size: 0.8rem;">&copy; 2026 Feedback Management System</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
